# ============================================================
# CouponVault Server – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
# ============================================================

# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# Inter-platform API key – generate with:
#   node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# Use at least 64 random hex characters.
API_KEY=<generate-a-strong-random-key>

PORT=4000
