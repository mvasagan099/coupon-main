# ============================================================
# CouponVault Server – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
# ============================================================

# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# Inter-platform API keys – generate strong 64-char random hex values:
# General server-to-server key:
API_KEY=<generate-a-strong-random-key>
# Dedicated calling application credentials (never shared or exposed to frontend):
GAMING_API_KEY=<gaming-application-server-secret-key>
LOTTERY_API_KEY=<lottery-application-server-secret-key>

PORT=4000

# Payment provider secrets (server only)
PAYPAL_CLIENT_ID=<paypal-public-client-id>
PAYPAL_CLIENT_SECRET=<paypal-secret>
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=<registered-webhook-id>
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-api-secret>
RAZORPAY_WEBHOOK_SECRET=<separate-webhook-signing-secret>
ALLOWED_ORIGINS=http://localhost:5173

# Edge Functions use PAYPAL_SECRET instead of PAYPAL_CLIENT_SECRET.
# Set their ALLOWED_ORIGINS to the actual frontend origins as well.
