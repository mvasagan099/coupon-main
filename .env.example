# ============================================================
# CouponVault – Full Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
# ============================================================

# ── Frontend (Vite — exposed to browser, must be prefixed VITE_) ─────────────

# Supabase project credentials (find at Supabase → Settings → API)
VITE_SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# PayPal — Client ID only (never put the secret here)
# Find at: developer.paypal.com → My Apps → App Details
VITE_PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID

# Public payment keys only. Match the account and test/live mode of the server keys.
# Direct checkout requires matching server webhook signing secrets.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=

# Coupon API server URL (same-origin in prod via Render; localhost in dev)
VITE_API_URL=http://localhost:4000

# ── Server (coupon/server/.env — never committed) ────────────────────────────

# Supabase service role key (full DB access — server ONLY)
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# API key for server-to-server calls from lottery-platform backend
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (used in emails / links)
FRONTEND_URL=http://localhost:5173

# ── Lottery Platform Integration ─────────────────────────────────────────────

# MegaDraw backend URL and API key (for inter-platform calls)
LOTTERY_API_URL=https://REPLACE_WITH_LOTTERY_BACKEND_URL
LOTTERY_API_KEY=REPLACE_WITH_LOTTERY_API_KEY
